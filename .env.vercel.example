# Copy into Vercel → Project → Settings → Environment Variables
# (Production), then Redeploy. Vite bakes these in at build time.

VITE_APP_TITLE=Hofros

# MUST include /api/v1 (Laravel lives under /api on Hostinger).
# Domain alone causes requests like /login with no CORS.
VITE_API_BASE_URL=https://your-hofros-site.hostingersite.com/api/v1

VITE_FRONTEND_URL=https://hofros.vercel.app
